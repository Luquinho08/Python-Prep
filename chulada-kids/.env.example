# ── Base ─────────────────────────────────────────────
# URL pública de la tienda (sin barra final). En producción debe ser HTTPS.
APP_URL=http://localhost:3000
DATABASE_URL=postgres://USUARIO:CLAVE@localhost:5432/chulada_dev
# Clave de 32 bytes en base64 para cifrar tokens de pago (openssl rand -base64 32).
APP_ENCRYPTION_KEY=
# Secreto para firmar enlaces temporales de archivos privados (openssl rand -base64 32).
APP_SIGNING_SECRET=
# Secreto para invocar /api/cron/* (openssl rand -hex 24).
CRON_SECRET=
# Carpeta de archivos subidos (fuera de public/).
STORAGE_DIR=./storage

# ── Pedidos / stock ──────────────────────────────────
RESERVATION_MINUTES=30
PENDING_PAYMENT_HOLD_HOURS=72
TERMS_VERSION=2026-09-borrador

# ── Mercado Pago ─────────────────────────────────────
# mercadopago = integración real con el SDK oficial.
# fake = simulador local rotulado (solo si NODE_ENV != production y ALLOW_FAKE_PAYMENTS=true).
PAYMENTS_DRIVER=mercadopago
ALLOW_FAKE_PAYMENTS=false
# Modo 1 (recomendado si la app de MP es de la misma cuenta): credenciales de servidor.
# NUNCA las pegues en el chat ni las subas al repositorio.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# test | production
MP_ENVIRONMENT=test
# Clave secreta de firma de webhooks (Tus integraciones → Webhooks).
MP_WEBHOOK_SECRET=
# Modo 3 (OAuth). Dejar vacío si no se usa.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_OAUTH_REDIRECT_URI=
MP_OAUTH_PKCE=false
# Texto en el resumen de la tarjeta (≈10 caracteres).
MP_STATEMENT_DESCRIPTOR=CHULADAKIDS

# ── Email ────────────────────────────────────────────
# smtp://usuario:clave@host:587 — si está vacío los emails quedan "skipped" (no se envían).
SMTP_URL=
EMAIL_FROM="Chulada Kids <hola@example.com>"
# Recibe avisos de pedidos pagados.
ADMIN_NOTIFICATION_EMAIL=
