    "file-type": "22.1.1",
    "mercadopago": "3.6.1",
    "next": "16.3.6",
    "nodemailer": "10.0.12",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.17.7",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
